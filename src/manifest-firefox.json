{
    "manifest_version": 3,
    "name": "ScrobbleScrubbler",
    "version": "1.0",
    "description": "Instant insights and bulk editing for your last.fm scrobbles, and more.",
    "author": "Lutz Brückner",
    "homepage_url": "https://github.com/hummingme/scrobblescrubbler#readme",
    "icons": {
        "48": "static/icons/scrubbler-disc_48.png",
        "128": "static/icons/scrubbler-disc_128.png"
    },
    "background": {
        "scripts": ["background.js"]
    },
    "content_scripts": [{
        "matches": ["https://www.last.fm/*"],
        "js": ["scrobble-scrubbler.js"]
    }],
    "permissions": [
        "storage",
        "scripting",
        "webRequest"
    ],
    "host_permissions": [
        "https://www.last.fm/*"
    ],
    "action": {
        "default_icon": {
            "16": "static/icons/scrubbler-disc_16.png",
            "32": "static/icons/scrubbler-disc_32.png"
        },  
        "default_title": "ScrobbleScrubbler",
        "default_popup": "static/popup.html"
    },
    "web_accessible_resources": [{
        "resources": ["static/scrobble-scrubbler.css"],
        "matches": ["https://www.last.fm/*"]
    }],
    "browser_specific_settings": {
        "gecko": {
            "id": "scrobble-scrubbler@kahuna.rocks",
            "strict_min_version": "128.0",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    }
}
